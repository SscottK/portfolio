# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — local dev (create the database first — see README)
DB_NAME=portfolio_dev
DB_USER=scott
DB_PASSWORD=
# Use socket path on WSL for passwordless local dev (matches psql).
# Use localhost + DB_PASSWORD when connecting over TCP (e.g. Render).
DB_HOST=/var/run/postgresql
DB_PORT=5432

# Render Postgres (set in dashboard or render.yaml — overrides DB_* when present)
# DATABASE_URL=postgresql://user:password@host:5432/portfolio

# Uploaded files — Render persistent disk mount (see render.yaml)
# MEDIA_ROOT=/var/data/media

# Frontend origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
